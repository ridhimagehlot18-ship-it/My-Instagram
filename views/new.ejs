<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create new post</title>
</head>
<body>
    <form method="post" action="/posts/new">
        <label for="name">Enter your username</label><br>
        <input name="user" type="text" placeholder="Enter username" id="name"><br>
        <label for="ans">Enter content</label><br>
        <textarea name="content" type="text" placeholder="Enter content" rows="3" cols="30" id="ans"></textarea><br>
        <button>Create post</button>
    </form>
</body>
</html>