<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Details of this post</title>
</head>
<body>
    <h1>Detailed Post</h1>
     <p>ID: <%=post.id%></p>
     <p>Username: <%=post.user%></p>
     <p>Content: <%=post.content%></p>
     <label>Image:</label><br>
     <img src="<%=post.img%>" style="height: 100px; width: 100px;">
</body>
</html>