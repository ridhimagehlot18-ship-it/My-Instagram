<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>My Instagram</h1>
  
        <% for(post of posts) { %>   
        <div class="indp">
        <p>id:<%=post.id%></p>
        <p><b><%=post.user%></b></p>
        <p><%=post.content%></p>
        <img src="<%=post.img%>" alt="this is image"><br>
        <a href="http://localhost:8080/posts/<%=post.id%>">Show this in Detail</a>
        </div>
         <%}%>
        <a href="http://localhost:8080/posts/new">Create a new Post</a>
</body>
</html>