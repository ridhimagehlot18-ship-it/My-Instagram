<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit the post</title>
</head>
<body>
    <form method="post" action="/posts/<%=post.id%>?_method=PATCH">
        <label>Username: <b><%=post.user%></b></label><br>
        <label for="ans">Content</label><br>
        <textarea id="ans" name="content" placeholder="<%=post.content%>" rows="3" cols="30"></textarea><br>
        <button>Edit</button>
    </form>
</body>
</html>